<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.chronicdisease.user.mapper.DoctorPatientMapper">

    <select id="getMyPatients" resultType="java.lang.Long">
        select patient_id from doctor_patient where doctor_id = #{doctorId} and is_deleted = 0;
    </select>
</mapper>